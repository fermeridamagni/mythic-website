---
const currentYear = new Date().getFullYear();
import { Image } from "astro:assets";
import WhiskyWineLogo from "@images/svg/light/Powered By WhiskyWine.light.svg";
---

<footer class="w-full border-t border-stroke-light bg-surface-light mt-16">
  <div
    class="max-w-7xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-center justify-between gap-4"
  >
    <a
      href="https://getwhisky.app"
      target="_blank"
      rel="noopener"
      class="opacity-70 hover:opacity-100 transition-opacity"
    >
      <Image
        src={WhiskyWineLogo}
        alt="Powered By WhiskyWine"
        loading="eager"
        class="h-8 w-auto"
      />
    </a>

    <p class="text-sm text-text-muted">
      &copy; {currentYear} Mythic. All rights reserved.
    </p>
  </div>
</footer>
