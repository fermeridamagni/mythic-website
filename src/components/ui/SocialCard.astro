---
interface Props {
  icon: "discord" | "github" | "heart" | "languages";
  title: string;
  desc: string;
  button?: string;
  href?: string;
  target?: string;
}

const { icon, title, desc, button, href, target } = Astro.props;

const iconPaths = {
  discord:
