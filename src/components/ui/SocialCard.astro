const viewBox = icon === "github" ? "0 0 32 32" : "0 0 16 16";
---

<article
  class="group flex flex-col p-6 bg-white rounded-2xl border border-stroke-light/50 hover:border-stroke-light hover:shadow-lg transition-all duration-300 h-full"
>
  <div
    class="w-12 h-12 mb-4 flex items-center justify-center rounded-xl bg-surface-light group-hover:bg-mythic-purple/10 transition-colors"
  >
    <svg
      class="w-6 h-6 text-text-secondary group-hover:text-mythic-purple transition-colors"
      fill="currentColor"
      viewBox={viewBox}
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d={iconPaths[icon]}
        fill-rule={icon === "heart" ? "evenodd" : undefined}></path>
    </svg>
  </div>

  <h3 class="text-lg font-semibold text-text-primary mb-2">{title}</h3>
  <p class="text-sm text-text-secondary mb-4 flex-1">{desc}</p>

  {
    href && button && (
      <a
        href={href}
        target={target}
        rel={target === "_blank" ? "noopener noreferrer" : undefined}
        class="inline-flex items-center gap-1 text-sm font-medium text-primary hover:text-primary-hover transition-colors group/link"
      >
        {button}
        <svg
          class="w-3 h-3 transform group-hover/link:translate-x-0.5 transition-transform"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 16 16"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M4.646 1.646a.5.5 0 0 1 .708 0L11.5 8l-6.146 6.354a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"
          />
        </svg>
      </a>
    )
  }
</article>
