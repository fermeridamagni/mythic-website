---
interface Props {
  title: string;
  desc: string;
  image: ImageMetadata;
  color?: string;
  footnote?: string;
  id?: string | number;
}

const { title, desc, image, color = "#a046ff", footnote = "" } = Astro.props;
import { Image } from "astro:assets";
---

<article
  class="group flex flex-col bg-white rounded-2xl p-6 shadow-sm hover:shadow-lg transition-all duration-300 border border-stroke-light/50"
>
  <div class="mb-4">
    <h3 class="text-lg font-semibold mb-2" style={`color: ${color};`}>
      {title}
    </h3>
    <p class="text-text-secondary text-base leading-relaxed">{desc}</p>
  </div>

  <div class="relative overflow-hidden rounded-xl">
    <Image
      src={image}
      loading="lazy"
      alt={title}
      class="w-full h-auto object-cover transform group-hover:scale-[1.02] transition-transform duration-500"
    />
  </div>

  {
    footnote && (
      <p class="mt-4 text-xs text-text-muted text-center">{footnote}</p>
    )
  }
</article>
