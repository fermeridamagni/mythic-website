---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import CTALogo from "@images/mythic_1024_np.png";
import CTAImage from "@images/mythic-screenshot.png";
import FeatureSection from "../components/sections/FeatureSection.astro";
import SocialCard from "../components/ui/SocialCard.astro";
import Footer from "../components/navigation/Footer.astro";

import FullscreenLibraryScreenshotLight from "@images/app/light/fs_library.png";
import GameSettingsScreenshotLight from "@images/app/light/gamesettings.png";
import ImportSheetScreenshotLight from "@images/app/light/importsheet.png";
import ContainerConfigurationScreenshotLight from "@images/app/light/containerconfiguration.png";
import AccountManagerScreenshotLight from "@images/app/light/accountmanager.png";
import MythicXcodeScreenshotLight from "@images/app/light/mythic_xcode.png";

export const features = [
  {
    title: "Your library, your way.",
    desc: "Easily manage all your games in one place, with a beautiful and customizable library.",
    image: FullscreenLibraryScreenshotLight,
    color: "#2294b1",
  },
  {
    title: "Open-source, open season!",
    desc: "Something isn't as good as it should be? Dig through the source code and help make it better.",
    image: MythicXcodeScreenshotLight,
    color: "#e241da",
  },
  {
    title: "Multiple launchers, one place.",
    desc: "Install, set up, and launch all your games from an external launcher, or by yourself.",
    image: AccountManagerScreenshotLight,
    color: "#3d44c3",
  },
  {
    title: "Game management, without the fuss.",
    desc: "Need to move your games around? Maybe, edit some settings? Add some flags? Mythic has you covered.",
    image: GameSettingsScreenshotLight,
    color: "#2294b1",
  },
  {
    title: "Import your own titles.",
    desc: "Epic not enough? Import your own macOS or Windows® titles directly into Mythic, and the rest is history.",
    image: ImportSheetScreenshotLight,
    color: "#e241da",
  },
  {
    title: "Virtualization? Child's play.",
    desc: "Create multiple environments of Windows® directly within Mythic, and keep all your games isolated safely from one another.",
    image: ContainerConfigurationScreenshotLight,
    color: "#3d44c3",
  },
];

const socials = [
  {
    icon: "github" as const,
    title: "Contribute to Mythic",
    desc: "Help in shaping Mythic through pull requests and issues.",
    href: "https://github.com/mythicapp",
    button: "Learn more",
  },
  {
    icon: "discord" as const,
    title: "Join the community",
    desc: "Join our Discord community to partake in future updates and discussions.",
    href: "https://discord.gg/58NZ7fFqPy",
    button: "Join the Discord",
  },
  {
    icon: "heart" as const,
    title: "Donate to the project",
    desc: "Supercharge Mythic's development and get benefits.",
    href: "https://github.com/sponsors/MythicApp",
    button: "Learn more",
  },
  {
    icon: "languages" as const,
    title: "Translate Mythic",
    desc: "Help us translate Mythic into your language, and see it live on the app.",
    href: "https://crowdin.getmythic.app/",
    button: "Learn more",
  },
];
---

<Layout title="Mythic">
  <!-- Hero Section -->
  <section
    class="flex flex-col items-center justify-center text-center px-6 py-16 md:py-24 max-w-5xl mx-auto"
  >
    <Image
      src={CTALogo}
      loading="eager"
      alt="Mythic logo"
      width={128}
      height={128}
      class="w-24 h-24 md:w-32 md:h-32 mb-8 animate-fade-in"
    />

    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 tracking-tight">
      <span class="gradient-text">The best way to play</span>
      <br />
      <span class="text-text-primary">Windows games on Mac.</span>
    </h1>

    <p
      class="text-lg md:text-xl text-text-secondary max-w-2xl mb-8 text-balance leading-relaxed"
    >
      An <a
        href="https://github.com/MythicApp"
        class="text-primary hover:underline">open-source</a
      > macOS game launcher with the ability to play Windows® games through a custom
      implementation of Apple's Game Porting Toolkit — supporting multiple platforms.
    </p>

    <div class="flex flex-col items-center gap-3">
      <a
        href="/download"
        class="inline-flex items-center px-8 py-3 text-lg font-medium text-white bg-primary hover:bg-primary-hover rounded-full transition-all shadow-lg hover:shadow-xl hover:scale-105"
      >
        Download Alpha
      </a>
      <span class="text-sm text-text-muted">for macOS 14+</span>
    </div>

    <div
      class="mt-16 w-full max-w-4xl animate-slide-up"
      style="animation-delay: 0.2s;"
    >
      <Image
        src={CTAImage}
        loading="eager"
        alt="Mythic app screenshot"
        class="w-full h-auto rounded-2xl shadow-2xl"
      />
    </div>
  </section>

  <!-- Features Section -->
  <section class="w-full bg-gradient-to-b from-surface-light to-white py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-text-primary mb-4"
        >
          Friends gaming without you?
        </h2>
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-bold gradient-text mb-6"
        >
          Mythic can fix that.
        </h2>
        <p class="text-lg text-text-secondary max-w-xl mx-auto">
          Time to throw all your virtual machines and subscriptions out of the
          window.
        </p>
      </div>

      <!-- Features Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {
          features.map((feature, index) => (
            <div
              class={
                index === 0 ? "md:col-span-2 lg:col-span-1 lg:row-span-2" : ""
              }
            >
              <FeatureSection
                title={feature.title}
                desc={feature.desc}
                image={feature.image}
                id={index + 1}
                color={feature.color}
                footnote={
                  index === 0
                    ? "Some Windows® games may not be supported for use within Mythic."
                    : index === 2
                      ? "Steam support is still in development."
                      : ""
                }
              />
            </div>
          ))
        }
      </div>

      <div class="text-center space-y-2">
        <p class="text-sm text-text-muted">
          We have even more to come, check out the{" "}
          <a
            href="https://github.com/orgs/MythicApp/projects/2/views/2"
            class="text-primary hover:underline"
          >
            roadmap
          </a>.
        </p>
        <p class="text-xs text-text-muted">
          (Please note that Mythic is still in its alpha stage of development;
          expect bugs.)
        </p>
      </div>
    </div>
  </section>

  <!-- Community Section -->
  <section class="w-full py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <h2
        class="text-3xl md:text-4xl font-bold text-center text-text-primary mb-12"
      >
        Join the Community
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          socials.map((social) => (
            <SocialCard
              icon={social.icon}
              title={social.title}
              desc={social.desc}
              href={social.href}
              button={social.button}
              target="_blank"
            />
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</Layout>
