---
import Layout from "../layouts/Layout.astro";
import FeatureSection from "../components/sections/FeatureSection.astro";
import { features } from "./index.astro";
---

<Layout title="Thanks for downloading!">
  <section
    class="flex flex-col items-center justify-center text-center px-6 py-16 md:py-24 max-w-4xl mx-auto min-h-[60vh]"
  >
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold mb-6 gradient-text">
      Thanks for downloading Mythic!
    </h1>

    <p class="text-lg text-text-secondary mb-4">
      You're just a few seconds away from greatness... (<span
        id="countdown-timer"
        class="font-bold text-primary">3</span
      >)
    </p>

    <p class="text-base text-text-secondary mb-4">
      If your download hasn't started, please <button
        onclick="fetchLatestRelease()"
        class="text-primary hover:underline cursor-pointer bg-transparent border-none"
        >click here</button
      >.
    </p>

    <div
      class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-8 max-w-lg"
    >
      <p class="text-sm text-amber-800">
        <strong>Note:</strong> For newer versions of macOS, you may need to toggle
        the 'Allow apps from' setting in System Settings → Privacy & Security → Security
        to 'Anywhere'.
      </p>
    </div>

    <p class="text-sm text-text-muted">
      For any concerns, please consult the <a
        href="/faq"
        class="text-primary hover:underline">FAQ</a
      > or join the <a href="/discord" class="text-primary hover:underline"
        >Discord</a
      >.
    </p>
  </section>

  <!-- Feature Showcase Marquee -->
  <section
    class="relative w-full overflow-hidden py-12 bg-gradient-to-b from-white to-surface-light"
  >
    <div class="flex animate-marquee">
      {
        features.concat(features).map((feature, index) => (
          <div class="flex-shrink-0 w-80 mx-3">
            <FeatureSection
              title={feature.title}
              desc={feature.desc}
              image={feature.image}
              id={String(index + 1)}
              color={feature.color}
            />
          </div>
        ))
      }
    </div>

    <!-- Fade edges -->
    <div
      class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-white to-transparent pointer-events-none z-10"
    >
    </div>
    <div
      class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-surface-light to-transparent pointer-events-none z-10"
    >
    </div>
  </section>
</Layout>

<script>
  const APPCAST_URL = "https://getmythic.app/appcast.xml";

  async function fetchLatestRelease() {
    const response = await fetch(APPCAST_URL).catch((error) => {
      console.error("Error fetching latest release:", error);
      return null;
    });
    if (!response) return null;

    const text = await response.text().catch((error) => {
      console.error("Error reading response text:", error);
      return null;
    });
    if (!text) return null;

    const parser = new DOMParser();
    const xml = parser.parseFromString(text, "text/xml");

    const error = xml.querySelector("parsererror");
    if (error) {
      console.error("Error parsing XML:", error);
      return null;
    }

    const items = Array.from(xml.getElementsByTagName("item"))
      .map((item) => ({
        title: item.getElementsByTagName("title")[0]?.textContent ?? null,
        versionNumber:
          item.getElementsByTagName("sparkle:version")[0]?.textContent ?? null,
        enclosure:
          item.getElementsByTagName("enclosure")[0]?.getAttribute("url") ??
          null,
      }))
      .filter(
        (item) =>
          item.title !== null &&
          item.versionNumber !== null &&
          item.enclosure !== null
      );

    const validItems = (
      items as { title: string; versionNumber: string; enclosure: string }[]
    )
      .map((item) => ({
        ...item,
        versionNumber: parseInt(item.versionNumber, 10),
      }))
      .filter((item) => !isNaN(item.versionNumber))
      .sort((a, b) => b.versionNumber - a.versionNumber);

    if (validItems.length === 0) {
      console.error("No valid releases found");
      return null;
    }

    const latestRelease = validItems[0];
    if (latestRelease?.enclosure) {
      window.location.href = latestRelease.enclosure;
    }

    return latestRelease;
  }

  // Make function available globally
  (window as any).fetchLatestRelease = fetchLatestRelease;

  async function main() {
    const countdownTimer = document.getElementById("countdown-timer");
    if (!countdownTimer) return;

    let countdown = 3;

    const interval = setInterval(async () => {
      if (countdown === 0) {
        clearInterval(interval);
        await fetchLatestRelease();
        return;
      }

      countdownTimer.textContent = countdown.toString();
      countdown -= 1;
    }, 1000);
  }

  main();
</script>
