---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found — Mythic">
  <section
    class="flex flex-col items-center justify-center text-center px-6 py-32 min-h-[70vh]"
  >
    <div class="text-8xl mb-6">🎮</div>
    <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
      Page Not Found
    </h1>
    <p class="text-lg text-text-secondary mb-8 max-w-md">
      Looks like this page wandered off to play some games. Let's get you back
      on track.
    </p>
    <a
      href="/"
      class="inline-flex items-center px-6 py-3 text-base font-medium text-white bg-primary hover:bg-primary-hover rounded-full transition-all shadow-lg hover:shadow-xl"
    >
      Go to Home
    </a>
  </section>
</Layout>
